{
  "name": "sparql-results",
  "version": "0.1.0",
  "type": "module",
  "author": "Ioannis Nezis <ioannis@nezis.de>",
  "description": "A framework-agnostic web component for rendering SPARQL results.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IoannisNezis/sparql-results.git"
  },
  "bugs": {
    "url": "https://github.com/IoannisNezis/sparql-results/issues"
  },
  "homepage": "https://github.com/IoannisNezis/sparql-results#readme",
  "keywords": [
    "sparql",
    "rdf",
    "web-component",
    "custom-element",
    "visualization",
    "semantic-web"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/sparql-results.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sparql-results.d.ts",
      "import": "./dist/sparql-results.js"
    }
  },
  "sideEffects": [
    "./dist/sparql-results.js"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "biome check",
    "format": "biome format --write",
    "lint": "biome lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "typescript": "~6.0.2",
    "unplugin-dts": "^1.0.2",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "yaml": "^2.9.0"
  }
}
